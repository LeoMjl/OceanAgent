{
  "name": "ocean-agent",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "files": [
    ".pi/SYSTEM.md",
    "dist/**/*.js",
    "frontend/dist/**",
    "Ocean-RAG/cards/.gitkeep",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,blue \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite --config frontend/vite.config.ts",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.json",
    "build:web": "vite build --config frontend/vite.config.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/tsconfig.json --noEmit",
    "test": "vitest run",
    "index:rag": "tsx src/scripts/index-rag.ts",
    "index:rag:rebuild": "tsx src/scripts/index-rag.ts --force"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.3.0",
    "@phosphor-icons/react": "2.1.10",
    "better-sqlite3": "13.0.3",
    "fastify": "^5.6.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.0.0"
  }
}
