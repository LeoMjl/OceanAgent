# Optional process-level server settings.
# OceanAgent does not load .env files; inject these through the shell or service manager.
HOST=127.0.0.1
PORT=3210
OCEAN_DB_PATH=./data/ocean-agent.sqlite
OCEAN_RAG_ROOT=./Ocean-RAG

# Runtime limits
CHAT_IDLE_TIMEOUT_MS=120000
CHAT_HARD_TIMEOUT_MS=1800000

# Remote execution process options. Server profiles and credentials are stored in SQLite.
OCEAN_PYTHON_PATH=python
OCEAN_SSH_CONNECT_TIMEOUT_MS=20000
OCEAN_SSH_COMMAND_TIMEOUT_MS=900000
OCEAN_SSH_STRICT_HOST_KEY=false
